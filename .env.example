NEXT_PUBLIC_SITE_URL=https://cloudgentechnologies.com
NEXT_PUBLIC_EUR_TO_INR=90
NEXT_PUBLIC_USD_TO_INR=92.9699
NEXT_PUBLIC_TAWK_PROPERTY_ID=6afb3da16e876a3cc05f8f42
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# SEO — Google Analytics 4 (G-XXXXXXXX) and Search Console HTML tag verification
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=paste_token_from_search_console

# Lead notifications go to sales@ only by default (protects ravit@ from Hostinger spam locks).
# Even if you list ravit@ here, it is stripped unless LEAD_COPY_FOUNDER=true.
LEAD_INBOX=sales@cloudgentechnologies.com
# LEAD_COPY_FOUNDER=true

# Daily SEO digest (Vercel Cron → /api/cron/seo-daily at 09:00 IST)
# Set the same CRON_SECRET in Vercel Project → Settings → Environment Variables.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=generate_a_long_random_string
# SEO_DIGEST_TO=sales@cloudgentechnologies.com

# CRM (own Postgres via DATABASE_URL) — lead nurture + follow-up tasks
# Day-0 thank-you sends on form submit; remaining steps run with seo-daily (09:00 IST).
# Manual trigger still available: GET /api/cron/crm-followups with Bearer CRON_SECRET
# DATABASE_URL=postgres://...
# CRM_DIGEST_TO=sales@cloudgentechnologies.com
# Optional dedicated secret for unsubscribe links (falls back to CRON_SECRET):
# CRM_UNSUBSCRIBE_SECRET=generate_another_long_random_string

# Social profiles (footer + schema). Leave blank to hide a network.
# NEXT_PUBLIC_SOCIAL_X=https://x.com/cloudgtech
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@your_cloudgen_channel
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/cloudgentech/
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/cloudgentech/

# Daily social post pack email (Vercel Cron → /api/cron/social-daily at 09:30 IST)
# Sends X / Facebook / Instagram / YouTube copy to paste or share.
# SOCIAL_DIGEST_TO=sales@cloudgentechnologies.com

# GA4 Data API (detailed traffic in the daily email)
# Admin → Property settings → Property ID (numbers only, NOT G-XXXXXXXX)
# GA4_PROPERTY_ID=123456789
# Create a GCP service account, enable "Google Analytics Data API" AND
# "Google Search Console API", download JSON key, add the SA email as:
#   - Viewer on the GA4 property
#   - User on Search Console (Settings → Users and permissions)
# then paste the JSON (or base64 of JSON) here / in Vercel:
# GA_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Search Console property URL must match GSC exactly (trailing slash for URL-prefix):
# GSC_SITE_URL=https://www.cloudgentechnologies.com/
# Domain property example: GSC_SITE_URL=sc-domain:cloudgentechnologies.com

# Option A — Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="CloudGen Technologies <sales@cloudgentechnologies.com>"

# Option B — Hostinger mailbox SMTP (required for register/demo lead emails)
# Domain MX is Hostinger — set these in .env.local AND Vercel Production.
# Always send FROM sales@ (never from ravit@) so founder inbox is not used for SMTP.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@cloudgentechnologies.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="CloudGen Technologies <sales@cloudgentechnologies.com>"
# Optional: SEO_DIGEST_TO=sales@cloudgentechnologies.com

# Option C — Gmail / Microsoft 365 SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=sales@cloudgentechnologies.com
# SMTP_PASS=your-app-password
# MAIL_FROM="CloudGen Technologies <sales@cloudgentechnologies.com>"

# Razorpay (Dashboard → API Keys). Use rzp_test_… for testing, rzp_live_… for production.
# Put real values only in .env.local / Vercel — do not leave xxxxxxxx placeholders set in the shell.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Free app demo window (days). Credentials stored in demo_accounts with expires_at.
DEMO_DURATION_DAYS=7
# DATABASE_URL is injected automatically when published with Postgres
